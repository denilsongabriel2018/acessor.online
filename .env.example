# App / Frontend
# Ambiente atual da aplicacao. Use development localmente, staging para teste e production na VPS.
NODE_ENV=development
# Ambiente ativo para escolher URLs sem trocar tudo manualmente: local, staging ou production.
APP_ENV=local
# Dominio principal do projeto.
ROOT_DOMAIN=assessoriatrafegando.com.br
# URLs locais usadas durante desenvolvimento.
LOCAL_APP_URL=http://localhost:5173
LOCAL_API_URL=http://localhost:3000
LOCAL_N8N_URL=http://localhost:5678
# URLs de teste/homologacao na VPS.
STAGING_APP_URL=https://teste-agenda.assessoriatrafegando.com.br
STAGING_API_URL=https://teste-agenda-api.assessoriatrafegando.com.br
STAGING_N8N_URL=https://teste-agenda-n8n.assessoriatrafegando.com.br
# URLs finais de producao.
PRODUCTION_APP_URL=https://agenda.assessoriatrafegando.com.br
PRODUCTION_API_URL=https://agenda-api.assessoriatrafegando.com.br
PRODUCTION_N8N_URL=https://agenda-n8n.assessoriatrafegando.com.br
# URLs ativas que o app vai usar agora. Localmente ficam em localhost.
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
N8N_BASE_URL=http://localhost:5678
# Fuso horario usado para prazos, resumos, lembretes e cobrancas.
APP_TIMEZONE=America/Sao_Paulo

# Backend API
# Porta local onde a API vai rodar.
PORT=3000
# Onde os dados ficam agora: memory para desenvolvimento local, supabase quando aplicar o schema.
STORAGE_DRIVER=memory
# Workspace padrao usado no MVP ate ativarmos usuarios/workspaces reais.
DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
# Origem autorizada a chamar a API pelo navegador. Em producao, usar a URL do frontend.
CORS_ORIGIN=http://localhost:5173
# Origens por ambiente, para nao precisar lembrar os dominios depois.
LOCAL_CORS_ORIGIN=http://localhost:5173
STAGING_CORS_ORIGIN=https://teste-agenda.assessoriatrafegando.com.br
PRODUCTION_CORS_ORIGIN=https://agenda.assessoriatrafegando.com.br
# Quantidade maxima de requisicoes permitidas por janela de tempo.
API_RATE_LIMIT_MAX=100
# Janela de tempo do rate limit.
API_RATE_LIMIT_WINDOW=1 minute

# Supabase
# URL do projeto Supabase.
SUPABASE_URL=
# Chave publica do Supabase. Pode ser usada no frontend junto com RLS ativo.
SUPABASE_ANON_KEY=
# Chave administrativa do Supabase. Usar somente no backend. Nunca expor no frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Usado somente para aplicar migrations pela CLI. Nao e a service_role.
SUPABASE_PROJECT_REF=akrjdhjcdgqokpjtypiw
# Opcao 1: token da sua conta Supabase para `supabase link`.
SUPABASE_ACCESS_TOKEN=
# Opcao 2: senha do banco Postgres do projeto para `supabase db push --db-url`.
SUPABASE_DB_PASSWORD=
# Opcao mais direta: connection string completa do banco em Project Settings > Database.
# Exemplo de formato: postgresql://postgres.xxxxxx:senha@host:6543/postgres
SUPABASE_DB_URL=

# Security
# Segredo para tokens internos do backend, caso usemos JWT proprio alem do Supabase Auth.
JWT_SECRET=
# Segredo que o n8n envia para a API provar que comandos vieram do workflow oficial.
N8N_TO_API_SECRET=
# Segredo que a API envia para o n8n provar que avisos/cobrancas vieram do app oficial.
API_TO_N8N_SECRET=
# Chave para assinatura HMAC do payload. Ajuda a detectar payload falso ou alterado.
WEBHOOK_HMAC_SECRET=

# n8n Webhooks Used By The App
# Webhook do n8n que recebe avisos, lembretes e cobrancas gerados pelo app.
N8N_NOTIFICATION_WEBHOOK_URL=
# Webhook do n8n para receber erros importantes do app, se quisermos alertas.
N8N_ERROR_WEBHOOK_URL=

# Scheduler
# Liga ou desliga o processo que verifica avisos, cobrancas e resumos.
SCHEDULER_ENABLED=true
# Intervalo, em segundos, entre cada varredura do scheduler.
SCHEDULER_INTERVAL_SECONDS=60
# Horario padrao do resumo diario do usuario.
DEFAULT_DAILY_SUMMARY_TIME=08:30

# Deploy
# Subdominios que voce precisa criar no DNS apontando para a VPS.
PUBLIC_APP_DOMAIN=agenda.assessoriatrafegando.com.br
PUBLIC_API_DOMAIN=agenda-api.assessoriatrafegando.com.br
PUBLIC_N8N_DOMAIN=agenda-n8n.assessoriatrafegando.com.br
PUBLIC_STAGING_APP_DOMAIN=teste-agenda.assessoriatrafegando.com.br
PUBLIC_STAGING_API_DOMAIN=teste-agenda-api.assessoriatrafegando.com.br
PUBLIC_STAGING_N8N_DOMAIN=teste-agenda-n8n.assessoriatrafegando.com.br

# Optional: Google Calendar Future Integration
# Deixe false no MVP. Quando true, ativa a integracao futura com Google Agenda.
GOOGLE_CALENDAR_ENABLED=false
# Client ID OAuth do Google, usado apenas se Google Agenda for ativado.
GOOGLE_CLIENT_ID=
# Client Secret OAuth do Google. Nunca usar no frontend.
GOOGLE_CLIENT_SECRET=
# URL de callback OAuth do Google.
GOOGLE_REDIRECT_URI=

# Observability
# Nivel de logs: debug, info, warn ou error.
LOG_LEVEL=info
# URL do Sentry para capturar erros em producao. Opcional.
SENTRY_DSN=


# Public Frontend Variables (Vite)
# Apenas variaveis com VITE_ ficam disponiveis no navegador.
# Nunca coloque service_role, OpenAI key ou secrets privados aqui.
VITE_API_URL=http://127.0.0.1:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
